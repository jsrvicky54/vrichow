<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title><%= title %> · Virchow Biotech Unit-5</title>
  <link rel="stylesheet" href="/css/style.css?v=biotech-background-3">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%231f5fbf'/%3E%3Cpath d='M16 8v8l5 3' stroke='white' stroke-width='3' fill='none' stroke-linecap='round'/%3E%3C/svg%3E">
  <script src="/js/app.js" defer></script>
</head>
<body>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">VB</span>
      <span class="brand-copy">
        <strong>VIRCHOW BIOTECH</strong>
        <small>PRIVATE LIMITED · UNIT-5 ATTENDANCE</small>
      </span>
    </a>
    <% if (user) { %>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
      <nav id="main-nav" class="nav">
        <% if (user.role === 'admin') { %>
          <a href="/admin" class="<%= path === '/admin' ? 'active' : '' %>">Dashboard</a>
          <a href="/admin/records" class="<%= path.startsWith('/admin/records') ? 'active' : '' %>">Records</a>
          <a href="/admin/summary" class="<%= path.startsWith('/admin/summary') ? 'active' : '' %>">Daily summary</a>
          <a href="/admin/staff" class="<%= path.startsWith('/admin/staff') ? 'active' : '' %>">Staff</a>
          <a href="/admin/ebooks" class="<%= path.startsWith('/admin/ebooks') ? 'active' : '' %>">E-Books</a>
          <a href="/admin/audit" class="<%= path.startsWith('/admin/audit') ? 'active' : '' %>">Audit log</a>
        <% } else { %>
          <a href="/staff" class="<%= path === '/staff' ? 'active' : '' %>">Sign in / out</a>
          <a href="/staff/history" class="<%= path.startsWith('/staff/history') ? 'active' : '' %>">My history</a>
        <% } %>
        <a href="/change-password" class="<%= path === '/change-password' ? 'active' : '' %>">Change password</a>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="linklike">Log out</button>
        </form>
      </nav>
    <% } %>
  </div>
</header>
<main class="container">
  <% if (user) { %>
    <p class="whoami"><%= user.name %> · <%= user.staff_id %><% if (user.department) { %> · <%= user.department %><% } %></p>
  <% } %>
  <% if (flash) { %>
    <div class="alert alert-<%= flash.type %>" role="status"><%= flash.text %></div>
  <% } %>
