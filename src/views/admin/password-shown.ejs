<%- include('../partials/header') %>

<section class="card narrow">
  <h1><%= heading %></h1>
  <p><strong><%= person.name %></strong> — Staff ID <strong><%= person.staff_id %></strong></p>

  <% if (generated) { %>
    <p>Temporary password:</p>
    <div class="temp-password"><%= password %></div>
    <div class="alert alert-warning mt">
      Write this down or give it to the person now. <strong>It will not be shown again.</strong>
      They will be asked to choose their own password when they first log in.
    </div>
  <% } else { %>
    <div class="alert alert-info">The account uses the password you typed. The person will be asked to choose their own password when they first log in.</div>
  <% } %>

  <div class="btn-group">
    <a class="btn btn-primary" href="/admin/staff">Back to staff list</a>
    <a class="btn" href="/admin/staff/new">Add another</a>
  </div>
</section>

<%- include('../partials/footer') %>
