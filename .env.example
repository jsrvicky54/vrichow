# Copy this file to .env and fill in the values.

# PostgreSQL connection string
DATABASE_URL=postgres://attendance:attendance@localhost:5432/attendance

# Set to "true" if your database requires SSL (most hosted databases do)
DATABASE_SSL=false

# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Log people out after this many minutes without activity
SESSION_IDLE_MINUTES=30

# Port the web server listens on
PORT=3000

# "production" turns on secure (HTTPS-only) cookies
NODE_ENV=development

# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, Nginx...)
TRUST_PROXY=0

# Office time zone (times are stored in UTC and shown in this zone)
APP_TIMEZONE=Asia/Kolkata

# Anyone whose first sign-in of the day is after this time is counted as late (24h HH:MM)
LATE_AFTER=10:00

# Login rate limits (per 15 minutes)
LOGIN_MAX_PER_IP=20
LOGIN_MAX_FAILS_PER_ACCOUNT=5

# Optional embedded spreadsheet editor (ONLYOFFICE Docs, HTTPS in production).
# Generate the shared secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ONLYOFFICE_DOCS_URL=
ONLYOFFICE_JWT_SECRET=
# Public base URL used by the editor's save callback; defaults to the current request host.
APP_BASE_URL=
